<%-- ==========================================================================
  Language Selection (Korean / Japanese / English)
========================================================================== --%>
<script>
window.gtranslateSettings = {
  "default_language": "ko",
  "native_language_names": true,
  "languages": ["ko", "ja", "en"],
  "wrapper_selector": ".gtranslate_wrapper"
};
</script>
<script src="https://cdn.gtranslate.net/widgets/latest/dropdown.js" defer></script>

<%-- ==========================================================================
  Language Detection + Image Replacement
  - GTranslate 무료 위젯의 googtrans 쿠키를 최우선으로 확인한다.
  - 쿠키가 없으면 localStorage를 참조한다.
  - html[data-kuro-lang]을 갱신해 배너 CSS를 전환한다.
  - [data-lang-img]가 붙은 <img>를 언어별 파일로 교체한다.
========================================================================== --%>
<script>
(function () {
  'use strict';

  // 1. googtrans 쿠키에서 언어 코드 추출 (예: /ko/ja → 'ja')
  function getCookieLang() {
    var m = document.cookie.match(/(?:^|;\s*)googtrans=\/[^\/]*\/([a-z-]+)/i);
    if (!m) return null;
    var lang = m[1].toLowerCase();
    return (lang === 'ja' || lang === 'en') ? lang : 'ko';
  }

  // 2. 최종 언어 결정: 쿠키 > localStorage > 기본값 'ko'
  function getCurrentLang() {
    var cookieLang = getCookieLang();
    if (cookieLang) return cookieLang;
    var savedLang = localStorage.getItem('nippon_buy_lang');
    return (savedLang === 'ja' || savedLang === 'en') ? savedLang : 'ko';
  }

  function applyLang(lang) {
    var html = document.documentElement;
    
    // 배너 CSS용 속성 갱신
    if (html.getAttribute('data-kuro-lang') !== lang) {
      html.setAttribute('data-kuro-lang', lang);
    }

    // 이미지 교체 (data-lang-img)
    var imgs = document.querySelectorAll('img[data-lang-img]');
    for (var i = 0; i < imgs.length; i++) {
      var img = imgs[i];
      var base = img.getAttribute('data-lang-img');
      var origSrc = img.getAttribute('data-lang-orig');
      if (!origSrc) {
        origSrc = img.getAttribute('src') || '';
        img.setAttribute('data-lang-orig', origSrc);
      }
      
      var nextSrc = origSrc;
      if (lang === 'ja') {
        nextSrc = origSrc.replace(base + '.png', base + '_jp.png');
      } else if (lang === 'en') {
        nextSrc = origSrc.replace(base + '.png', base + '_en.png');
      }
      
      if (nextSrc !== img.getAttribute('src')) {
        img.setAttribute('src', nextSrc);
      }
    }
  }

  // 페이지 로드 시 언어 적용
  applyLang(getCurrentLang());

  // GTranslate 드롭다운 클릭 감지 (보조 수단)
  document.addEventListener('click', function (e) {
    var wrapper = e.target.closest('.gtranslate_wrapper');
    if (!wrapper) return;

    var link = e.target.closest('a');
    if (!link) return;

    var text = link.textContent.trim();
    var newLang = null;

    if (text.indexOf('日本語') !== -1 || text.indexOf('Japanese') !== -1) {
      newLang = 'ja';
    } else if (text.indexOf('English') !== -1) {
      newLang = 'en';
    } else if (text.indexOf('한국어') !== -1 || text.indexOf('Korean') !== -1 || text.indexOf('원본') !== -1) {
      newLang = 'ko';
    }

    if (newLang) {
      localStorage.setItem('nippon_buy_lang', newLang);
      applyLang(newLang);
    }
  });

  // GTranslate가 <html lang="...">을 변경할 때 동기화 (보조 수단)
  var observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      if (mutation.type === 'attributes' && mutation.attributeName === 'lang') {
        var lang = document.documentElement.getAttribute('lang');
        if (lang === 'ja' || lang === 'en' || lang === 'ko') {
          localStorage.setItem('nippon_buy_lang', lang);
          applyLang(lang);
        }
      }
    });
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });

})();
</script>